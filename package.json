{
  "name": "create-harness-agile",
  "version": "0.2.1",
  "description": "Create portable Claude Code and Codex projects (Python 3.11+ or uv required)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CXPhoenix/harness-agile.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "create-harness-agile": "bin/create.cjs"
  },
  "files": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "bin",
    "harness_agile/**/*.py",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "bootstrap",
    ".gitignore",
    ".gitattributes",
    "skills-lock.json",
    ".agents/skills",
    ".claude/agents",
    ".codex/agents",
    ".codex/config.toml",
    "docs",
    ".tmpl.docs",
    "scripts/init-project.py",
    "scripts/verify-project.py",
    "scripts/skill_links.py",
    "scripts/sync-skills.py",
    "scripts/project-readme.md",
    "tests/test_init_project.py"
  ],
  "scripts": {
    "test": "node bin/python.cjs -m unittest discover -s tests -v"
  }
}
